---
import "../styles/global.css";
import Header from "../components/Header";

const {
  title,
  description = "Rolando learns how your Discord server talks, then talks back: replies, reactions, gifs and voice chat.",
} = Astro.props;
const fullTitle = title ? `${title} · Rolando` : "Rolando";
// build.format "file" makes pathname /index.html, /guild.html…; nginx serves them extensionless
const url = new URL(
  Astro.url.pathname.replace(/(index)?\.html$/, ""),
  Astro.site,
).href;
const image = new URL("/android-chrome-512x512.png", Astro.site).href;
// Docker builds bake placeholders here; the container swaps in its env on start (see Dockerfile).
const invite = process.env.INVITE_URL ?? "";
const repo = process.env.REPO_URL ?? "";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Rolando" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#6366f1" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {invite && <meta name="rolando:invite" content={invite} />}
  </head>
  <body class="flex min-h-screen flex-col">
    <Header client:load />
    <main class="mx-auto w-full max-w-7xl flex-1 p-4 lg:p-6">
      <slot />
    </main>
    <footer class="muted flex justify-center gap-6 border-t border-neutral-900 p-4 text-sm">
      <a href="/premium">Premium</a>
      <a href="/privacy-policy">Privacy Policy</a>
      <a href="/terms-of-service">Terms of Service</a>
      {repo && (
        <a class="env-link" href={repo} rel="noopener">
          Source code
        </a>
      )}
    </footer>
  </body>
</html>
