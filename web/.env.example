# Copy to .env. Dev only; in Docker set API_URL on the web container.
# Backend JSON API the dev server proxies /api to (matches SERVER_ADDRESS)
API_URL=http://localhost:8080
# Dev server port
PORT=4321
# Public origin (sitemap, robots.txt, security.txt). Docker: runtime env on the web container.
SITE_URL=http://localhost:4321
# Optional links, runtime env on the web container in Docker; empty = unchanged behaviour
# Invite button target (else the bot's own INVITE_URL from /api/bot)
INVITE_URL=
# "Source code" footer link (hidden when empty)
REPO_URL=
# Official Discord server invite, linked from the privacy policy and terms (plain text when empty)
COMMUNITY_INVITE_URL=
