# ![REQUIRED]
TOKEN=

INVITE_URL=
# IDs with access to the admin panel
OWNER_IDS=

# ? [Not Required] JSON API for the web UI in web/ (defaults 127.0.0.1:8080), disable with RUN_HTTP_SERVER=false
SERVER_ADDRESS=
RUN_HTTP_SERVER=
# Public URL of the web UI (it proxies /api here); <SITE_URL>/api/auth/callback must be registered in the developer portal
SITE_URL=http://localhost:4321
# OAuth2 client secret from the developer portal, needed for login
OAUTH_CLIENT_SECRET=
# Signs session cookies; random per process if unset (required with NODE_COUNT > 1)
SESSION_SECRET=

# ? [Not Required] Storage: data/guilds/<id>/{guild.db,chain.snap}
DATA_DIR=data
CHAIN_IDLE_TTL=30m
SNAPSHOT_INTERVAL=10m

# ? [Not Required] Sharding: node i runs shards {s | s % NODE_COUNT == i}
SHARD_COUNT=16
NODE_COUNT=1
NODE_INDEX=0
# Peer node API address template and this node's bind address (only used with NODE_COUNT > 1)
NODE_ADDR=http://rolando-%d:9000
NODE_API_ADDRESS=0.0.0.0:9000
NODE_SECRET=
# rsync destination template for `rolando rebalance` across hosts
REBALANCE_DEST=

# ! ---------------- Monetization -----------------------
# ? [Not Required] paywalls for subscription based features (defaults true)
PAYWALLS_ENABLED=
# ? [Not Required] SKU IDs of the bot's subscriptions
VOICE_CHAT_FEATURES_SKU_ID=
# ? [Not Required] link to the bot's premium page for external sales
PREMIUMS_PAGE_LINK=

# ? [Not Required] example docker-compose.yml: web host port
WEB_PORT=
